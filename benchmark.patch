+
+static void bench_share_record(struct net_packet *packet)
+{
+    if (!bench_share.enabled || ntohl(packet->src->addr.sin.sin_addr.s_addr) != bench_share.packet_src)
+        return;
+    double elapsed = now - 1000 - bench_share.anchor;
+    if (elapsed < 0 || elapsed >= bench_share.duration)
+        return;
+    size_t bin = elapsed / bench_share.step;
+    if (bin < bench_share.num_bins)
+        bench_share.bins[bin] += packet->size;
+}
+
+static void bench_share_print(void)
+{
+    if (!bench_share.enabled)
+        return;
+    uint64_t bytes = 0;
+    for (size_t i = 0; i != bench_share.num_bins; ++i) {
+        bytes += bench_share.bins[i];
+        if (i >= bench_share.window_bins)
+            bytes -= bench_share.bins[i - bench_share.window_bins];
+        if (i + 1 >= bench_share.window_bins)
+            printf("BENCH_SHARE %.6f %.9f\n", (i + 1) * bench_share.step,
+                   bytes / (bench_share.bandwidth * bench_share.window_bins * bench_share.step));
+    }
 }
 
