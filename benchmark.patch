+    uint8_t *dst = _dst;
+    while (len != 0) {
+        uint64_t z = (bench_random_state += UINT64_C(0x9e3779b97f4a7c15));
+        z = (z ^ (z >> 30)) * UINT64_C(0xbf58476d1ce4e5b9);
+        z = (z ^ (z >> 27)) * UINT64_C(0x94d049bb133111eb);
+        z ^= z >> 31;
+        for (unsigned i = 0; i != 8 && len != 0; ++i, --len) {
+            *dst++ = z;
+            z >>= 8;
+        }
+    }
+}
