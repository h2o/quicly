From 881d89550106bfd4e573704f3c574af73f9c7335 Mon Sep 17 00:00:00 2001
From: Kazuho Oku <kazuhooku@gmail.com>
Date: Fri, 9 Oct 2026 18:28:31 +0900
Subject: [PATCH] [cli] experimental kernel pacing using SCM_TXTIME

`quicly_send_get_pacing_rate` returns the rate of quicly's pacer. With `--so-txtime`, cli enables SO_TXTIME on the socket and
gives each packet a departure time (SCM_TXTIME), spaced at that rate from the previous packet's departure time, so that the fq
qdisc releases the packets one by one instead of in the bursts that quicly's pacer permits.

Known issue: quicly measures RTT from when the packet is handed to the socket, so time spent waiting in fq is counted as RTT.
---
 include/quicly.h |  4 ++++
 lib/quicly.c     |  5 ++++
 src/cli.c        | 59 ++++++++++++++++++++++++++++++++++++++++++++++--
 3 files changed, 66 insertions(+), 2 deletions(-)

diff --git a/include/quicly.h b/include/quicly.h
index cf8efa0d..f184076d 100644
--- a/include/quicly.h
+++ b/include/quicly.h
@@ -1371,6 +1371,10 @@ size_t quicly_send_retry(quicly_context_t *ctx, ptls_aead_context_t *token_encry
  */
 quicly_error_t quicly_send(quicly_conn_t *conn, quicly_address_t *dest, quicly_address_t *src, struct iovec *datagrams,
                            size_t *num_datagrams, void *buf, size_t bufsize);
+/**
+ * returns the rate at which the packets built by `quicly_send` are paced, in bytes per millisecond
+ */
+uint32_t quicly_send_get_pacing_rate(quicly_conn_t *conn);
 /**
  * returns ECN bits to be set for the packets built by the last invocation of `quicly_send`
  */
diff --git a/lib/quicly.c b/lib/quicly.c
index 6b6f786f..eaf96711 100644
--- a/lib/quicly.c
+++ b/lib/quicly.c
@@ -6036,6 +6036,11 @@ Exit:
     return ret;
 }
 
+uint32_t quicly_send_get_pacing_rate(quicly_conn_t *conn)
+{
+    return calc_pacer_send_rate(conn);
+}
+
 uint8_t quicly_send_get_ecn_bits(quicly_conn_t *conn)
 {
     return conn->egress.ecn.state == QUICLY_ECN_OFF ? 0 : is_l4s(conn) ? 1 : 2; /* NON-ECT, ECT(1), or ECT(0) */
diff --git a/src/cli.c b/src/cli.c
index 4d735ebd..8113fc72 100644
--- a/src/cli.c
+++ b/src/cli.c
@@ -38,6 +38,9 @@
 #include <signal.h>
 #include <stdio.h>
 #include <unistd.h>
+#ifdef __linux__
+#include <linux/net_tstamp.h>
+#endif
 #include <picotls.h>
 #include <openssl/err.h>
 #if QUICLY_HAVE_FUSION
@@ -55,6 +58,13 @@ FILE *quicly_trace_fp = NULL;
 static unsigned verbosity = 0;
 static int suppress_output = 0, send_datagram_frame = 0;
 static int delivery_stats = 0;
+static int so_txtime = 0;
+/**
+ * when SO_TXTIME is used, the interval between the departures of packets in nanoseconds per byte (zero when not used), and the
+ * departure time (CLOCK_MONOTONIC) of the next packet
+ */
+static double txtime_ns_per_byte;
+static uint64_t txtime_next;
 static struct {
     uint64_t next_at, bytes;
 } delivered;
@@ -597,11 +607,34 @@ static void set_ecn(struct msghdr *mess, uint8_t ecn)
     mess->msg_controllen += CMSG_SPACE(sizeof(ecn));
 }
 
+static void set_txtime(struct msghdr *mess, size_t len)
+{
+#ifdef SCM_TXTIME
+    if (txtime_ns_per_byte == 0)
+        return;
+
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    uint64_t now = (uint64_t)ts.tv_sec * 1000000000 + ts.tv_nsec;
+    if (txtime_next < now)
+        txtime_next = now;
+
+    struct cmsghdr *cmsg = (struct cmsghdr *)((char *)mess->msg_control + mess->msg_controllen);
+    cmsg->cmsg_level = SOL_SOCKET;
+    cmsg->cmsg_type = SCM_TXTIME;
+    cmsg->cmsg_len = CMSG_LEN(sizeof(txtime_next));
+    memcpy(CMSG_DATA(cmsg), &txtime_next, sizeof(txtime_next));
+    mess->msg_controllen += CMSG_SPACE(sizeof(txtime_next));
+
+    txtime_next += (uint64_t)(len * txtime_ns_per_byte);
+#endif
+}
+
 static void send_packets_default(int fd, quicly_address_t *dest, quicly_address_t *src, struct iovec *packets, size_t num_packets,
                                  uint8_t ecn)
 {
     for (size_t i = 0; i != num_packets; ++i) {
-        char cmsgbuf[CMSG_SPACE(sizeof(struct in6_pktinfo)) + CMSG_SPACE(sizeof(int))];
+        char cmsgbuf[CMSG_SPACE(sizeof(struct in6_pktinfo)) + CMSG_SPACE(sizeof(int)) + CMSG_SPACE(sizeof(uint64_t))];
         struct msghdr mess = {
             .msg_name = dest,
             .msg_namelen = quicly_get_socklen(&dest->sa),
@@ -612,6 +645,7 @@ static void send_packets_default(int fd, quicly_address_t *dest, quicly_address_
         if (src != NULL && src->sa.sa_family != AF_UNSPEC)
             set_srcaddr(&mess, src);
         set_ecn(&mess, ecn);
+        set_txtime(&mess, packets[i].iov_len);
         assert(mess.msg_controllen <= sizeof(cmsgbuf));
         if (mess.msg_controllen == 0)
             mess.msg_control = NULL;
@@ -686,8 +720,23 @@ static quicly_error_t send_pending(int fd, quicly_conn_t *conn)
     size_t num_packets = MAX_BURST_PACKETS;
     quicly_error_t ret;
 
-    if ((ret = quicly_send(conn, &dest, &src, packets, &num_packets, buf, sizeof(buf))) == 0 && num_packets != 0)
+    if ((ret = quicly_send(conn, &dest, &src, packets, &num_packets, buf, sizeof(buf))) == 0 && num_packets != 0) {
+#ifdef SO_TXTIME
+        if (so_txtime) {
+            /* Let the kernel (i.e., the fq qdisc) space out the bursts that quicly's pacer emits, by giving each packet a departure
+             * time at the rate of quicly's pacer. */
+            static int enabled;
+            if (!enabled) {
+                struct sock_txtime config = {.clockid = CLOCK_MONOTONIC};
+                if (setsockopt(fd, SOL_SOCKET, SO_TXTIME, &config, sizeof(config)) != 0)
+                    perror("setsockopt(SO_TXTIME) failed");
+                enabled = 1;
+            }
+            txtime_ns_per_byte = 1e6 / quicly_send_get_pacing_rate(conn);
+        }
+#endif
         send_packets(fd, &dest, &src, packets, num_packets, quicly_send_get_ecn_bits(conn));
+    }
 
     return ret;
 }
@@ -1338,6 +1387,9 @@ static void usage(const char *cmd)
            "  -r [initial-pto]          initial PTO (in milliseconds)\n"
            "  --abba                    enables ABBA bandwidth adaptation\n"
            "  --l4s                     enables L4S with CUBACK (including pacing)\n"
+           "  --so-txtime               gives each packet a departure time (SCM_TXTIME), spacing\n"
+           "                            them at the pacing rate, so that the fq qdisc paces each\n"
+           "                            packet (Linux only)\n"
            "  --rapid-start             turns on rapid start\n"
            "  -S [num-speculative-ptos] number of speculative PTOs\n"
            "  -s session-file           file to load / store the session ticket\n"
@@ -1679,6 +1731,7 @@ int main(int argc, char **argv)
                                              {"rapid-start", no_argument, NULL, 0},
                                              {"abba", no_argument, NULL, 0},
                                              {"l4s", no_argument, NULL, 0},
+                                             {"so-txtime", no_argument, NULL, 0},
                                              {"sockfd", required_argument, NULL, 0},
                                              {"exit-after-handshake", no_argument, NULL, 0},
                                              {"calc-initial-secret", required_argument, NULL, 0},
@@ -1696,6 +1749,8 @@ int main(int argc, char **argv)
                 ech_setup_configs(optarg);
             } else if (strcmp(longopts[opt_index].name, "disable-ecn") == 0) {
                 ctx.egress[0].ecn = QUICLY_ECN_MODE_OFF;
+            } else if (strcmp(longopts[opt_index].name, "so-txtime") == 0) {
+                so_txtime = 1;
             } else if (strcmp(longopts[opt_index].name, "l4s") == 0) {
                 ctx.egress[0].ecn = QUICLY_ECN_MODE_L4S;
                 ctx.egress[0].pacing = 1;
-- 
